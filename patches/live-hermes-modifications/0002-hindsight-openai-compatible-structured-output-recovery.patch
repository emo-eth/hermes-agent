+def _extract_balanced_json(content: str) -> str | None:
+    """Return the first balanced JSON object/array embedded in provider text.
+
+    Local models sometimes prepend prose despite schema mode. json.loads() then
+    fails with "Extra data" or "Expecting value" even though a valid JSON object
+    is present. This scanner keeps string/escape state so braces inside strings
+    don't corrupt the balance check.
+    """
+    starts = [idx for idx in (content.find("{"), content.find("[")) if idx >= 0]
+    if not starts:
+        return None
+    start = min(starts)
+    opener = content[start]
+    closer = "}" if opener == "{" else "]"
+    stack = [closer]
+    in_string = False
+    escape = False
+    for idx in range(start + 1, len(content)):
+        ch = content[idx]
+        if in_string:
+            if escape:
+                escape = False
+            elif ch == "\\":
+                escape = True
+            elif ch == '"':
+                in_string = False
+            continue
+        if ch == '"':
+            in_string = True
+        elif ch == "{":
+            stack.append("}")
+        elif ch == "[":
+            stack.append("]")
+        elif ch in "}]":
+            if not stack or ch != stack[-1]:
+                return None
+            stack.pop()
+            if not stack:
+                return content[start : idx + 1]
+    return None
+
+
+def _coerce_numbered_fact_text(content: str) -> dict[str, Any] | None:
+    """Coerce Gemma's common numbered fact prose into FactExtractionResponse JSON.
+
+    The Hindsight retain path asks for {"facts": [...]}, but gemma4:e2b-mlx often
+    ignores Ollama's schema and emits repeated blocks like:
+      1. **what**: ...
+      2. **when**: ...
+      ...
+      fact_type: assistant
+    Treat that as recoverable instead of spending four GPU-heavy retries.
+    """
+    if "**what**" not in content and "fact_type:" not in content:
+        return None
+    blocks = re.split(r"(?m)^\s*\d+\.\s+\*\*what\*\*\s*:\s*", content)
+    facts: list[dict[str, Any]] = []
+    for block in blocks[1:]:
+        text = "what: " + block
+        fields: dict[str, str] = {}
+        for name in ("what", "when", "where", "who", "why"):
+            m = re.search(
+                rf"(?is)(?:^|\n)\s*(?:\d+\.\s+)?(?:\*\*)?{name}(?:\*\*)?\s*:\s*(.*?)(?=\n\s*(?:\d+\.\s+)?(?:\*\*)?(?:what|when|where|who|why)(?:\*\*)?\s*:|\n\s*fact_(?:kind|type)\s*:|\Z)",
+                text,
+            )
+            fields[name] = (m.group(1).strip() if m else "N/A")
+        fact_kind_match = re.search(r"(?im)^\s*fact_kind\s*:\s*(\w+)", text)
+        fact_type_match = re.search(r"(?im)^\s*fact_type\s*:\s*(\w+)", text)
+        what = fields.get("what", "").strip()
+        if not what or what.upper() == "N/A":
+            continue
+        facts.append(
+            {
+                "what": what,
+                "when": fields.get("when") or "N/A",
+                "where": fields.get("where") or "N/A",
+                "who": fields.get("who") or "N/A",
+                "why": fields.get("why") or "N/A",
+                "fact_kind": fact_kind_match.group(1) if fact_kind_match else "conversation",
+                "fact_type": fact_type_match.group(1) if fact_type_match else "assistant",
+                "entities": [],
+            }
+        )
+    return {"facts": facts} if facts else None
 
 
